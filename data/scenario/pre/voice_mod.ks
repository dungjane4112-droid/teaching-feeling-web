;;-------------face_mod-----------
[macro name="dress_face_r"]
[iscript]
f.r=Math.floor(Math.random() * 27 + 1);
[endscript]
[if exp="f.r==1"][f/cp_nt]
[elsif exp="f.r==2"][f/p_nt][um_01]
[elsif exp="f.r==3"][f/clp_nt][um_02]
[elsif exp="f.r==4"][f/cp_nt][um_05]
[elsif exp="f.r==5"][f/sc_nt][sm_02]
[elsif exp="f.r==6"][f/q_nt][um_09]
[elsif exp="f.r==7"][f/sq_nt][sm_09]
[elsif exp="f.r==8"][f/clp_nt][um_02]
[elsif exp="f.r==9"][f/scp_nt][sm_02]
[elsif exp="f.r==10"][f/sclcp_nt][um_10]
[elsif exp="f.r==11"][f/clcp_nt][um_07]
[elsif exp="f.r==12"][f/cq_nt][um_01]
[elsif exp="f.r==13"][f/scq_nt][um_06]

[elsif exp="f.r==14"][f/p_nt]
[elsif exp="f.r==15"][f/clp_nt]
[elsif exp="f.r==16"][f/cp_nt]
[elsif exp="f.r==17"][f/sc_nt]
[elsif exp="f.r==18"][f/q_nt]
[elsif exp="f.r==19"][f/sq_nt]
[elsif exp="f.r==20"][f/clp_nt]
[elsif exp="f.r==21"][f/scp_nt]
[elsif exp="f.r==22"][f/sclcp_nt]
[elsif exp="f.r==23"][f/clcp_nt]
[elsif exp="f.r==24"][f/cq_nt]
[elsif exp="f.r==25"][f/scq_nt]
[else]
[endif]
[endmacro]


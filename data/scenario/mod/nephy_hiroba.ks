;;==============================neph_talk=================================
*nephy_talk_lead
[cm ][stopbgm]
[bgm_ST]
[if exp="f.neph_wait>=1 || f.thoi_tiet==1 || f.thoi_tiet==2 || f.thoi_tiet==4 || f.thoi_tiet==5"]
[jump storage="mod/hiroba_alone.ks" target="*hiroba_random_other"]
[endif]
[eval exp="f.neph_wait=1" ]
(Phía trước hình như có ai đó trông khá quen[p]
Tôi nên làm gì đây[r]
[chara_mod name="sub" time="600" storage="o/sub/ne_def/ne_non_a1a.png" ]
[chara_show name="sub" time="1" left="0" time="400" wait="true" zindex="20" ]
[chara_mod name="h" time="1" storage="00.png" ]
[chara_show name="h" time="1" left="0" time="0" wait="true" zindex="30" ]
[mod_win st="o/win/out_win.png" ]
[chara_show name="window" time="1" wait="false" left="855" top="41" zindex="10"]
[set_time]
[anim name="sub" time="250" left="-200" ]
[button  target="*neph_random"  graphic="s_menu/chao_hoi.png"  x="845"  y="240" ]
[button  target="*tranh_mat"  graphic="s_menu/thoi.png"  x="845"  y="320" ]
[s ]

*tranh_mat
[cm ][eval exp="f.talk='nxy'" ]
[chara_mod name="sub" time="600" storage="00.png" ]
#
(Tôi quyết định tránh đi)[p]
[jump storage="mod/hiroba_alone.ks" target="*choice" ]

*neph_random
[random_10][if exp="f.r>=2 && f.r<=7"]
[eval exp="f.neph_wst='on'"][endif]
[random_4]
[if exp="f.ne_love>=0"][eval exp="f.ne_love=f.ne_love+f.r+1"][else][eval exp="f.ne_love=1"][endif]
[cm ]
[if exp="f.neph_st>=1"][else]
[jump  target="*neph_talk_f" ][endif]
[random_10]
[if exp="f.neph_st>=3 && f.ne_love>=250 && f.r>=5"]
[jump storage="mod/nephy_date1.ks" target="*neph_talk_date1"]
[elsif exp="f.neph_st>=3 && f.ne_love>=150 && f.r>=6"]
[jump storage="mod/nephy_date1.ks" target="*neph_talk_date1"][endif]
[random_13]
[mod_win st="00.png" ]
[chara_mod name="other" time="0" storage="00.png" ]
[eval exp="f.talk='nxy'" ]
[if exp="f.r==1" ][jump  target="*neph_talk1" ]
[elsif exp="f.r==2" ][jump target="*neph_talk2" ]
[elsif exp="f.r==3" ][jump target="*neph_talk3" ]
[elsif exp="f.r==4" ][jump target="*neph_talk4" ]
[elsif exp="f.r==5" ][jump target="*neph_talk5" ]
[elsif exp="f.r==6" ][jump target="*neph_talk6" ]
[elsif exp="f.r==7" ][jump target="*neph_talk7" ]
[elsif exp="f.r==8" ][jump target="*neph_talk8" ]
[elsif exp="f.r==9" ][jump target="*neph_talk9" ]
[elsif exp="f.r==10" ][jump target="*neph_talk10" ]
[elsif exp="f.r==11" ][jump target="*neph_talk11" ]
[elsif exp="f.r==12" ][jump target="*neph_talk12" ]
[elsif exp="f.r==13" ][jump target="*neph_talk13" ]

[elsif exp="f.r==14" ][jump target="*neph_talk2" ]
[elsif exp="f.r==15" ][jump target="*neph_talk12" ]
[elsif exp="f.r==16" ][jump target="*neph_talk7" ]
[elsif exp="f.r==17" ][jump target="*neph_talk8" ]
[elsif exp="f.r==18" ][jump target="*neph_talk9" ]
[elsif exp="f.r==19" ][jump target="*neph_talk10" ]
[elsif exp="f.r==20" ][jump target="*neph_talk13" ]
[else][jump  target="*neph_talk4" ]
[endif]


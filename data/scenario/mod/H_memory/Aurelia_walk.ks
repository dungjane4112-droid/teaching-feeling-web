;;========script_by_ichibikun============

*begin
[jump target="*tear_next"]

*tear_next
[black][stopbgm][cm][show_message_w]
[mod_win st="o/food/00.png" ]
[chara_00][set_lady_x]
[chara_show name="x" time="1" zindex="5" ]
[chara_show name="ef" time="1" zindex="25" ]
[cm]
[stopbgm]
[playbgm  loop="true"  storage="Deep_Scarlet.ogg" ]
[bg  time="500"  method="crossfade"  storage="bg/mod/shop_H_.jpg" ]
[if exp="f.lady==6"]
[chara_mod name="h" time="0" storage="o/sub/mod/Aurelia_a_x_00.png" ]
[elsif exp="f.lady==7"]
[chara_mod name="h" time="0" storage="o/sub/mod/Aurelia_b_x_00.png" ]
[elsif exp="f.lady==8"]
[chara_mod name="h" time="0" storage="o/sub/mod/Aurelia_c_x_00.png" ]
[elsif exp="f.lady==12"]
[chara_mod name="h" time="0" storage="o/sub/mod/Aurelia_xa_00.png"][endif]
[aur_sr]
[chara_show name="h" time="1" zindex="1" ]
[chara_show name="sub" time="300" zindex="10" ]
[chara_show name="p" time="1" zindex="15" ]
[chara_show name="tear" time="1" zindex="30" ]
[bg  time="10"  method="crossfade"  storage="bg/mod/shop_H.jpg" ]
#Aurelia
[aur_sone_1]Anh ở đây đợi một lát nhé. Tôi sẽ chuẩn bị ngay đây.[p]
[bg  time="10"  method="crossfade"  storage="bg/mod/shop_H_.jpg" ]
[chara_mod name="h" time="1" storage="o/food/00.png" ]
[chara_mod name="sub" time="700" storage="o/food/00.png" wait="true" ]
[_]
(Cô ấy vào trong pha trà cho tôi...[p]
[bg  time="10"  method="crossfade"  storage="bg/mod/bg_aur_tear.jpg" ]
[chara_mod name="x" time="0" storage="o/food/aur_ghe_tear.png"]
[chara_mod name="ef" time="0" storage="o/food/aur_ban_tear.png"]

.[wait time="500"].[wait time="500"].[wait time="500"][cm]

[aur_sl]
[if exp="f.lady==6"]
[chara_mod name="tx" time="200" storage="o/sub/aurelia_huge/Aurelia_a_x_hug_00.png"]
[elsif exp="f.lady==7"]
[chara_mod name="tx" time="200" storage="o/sub/aurelia_huge/Aurelia_b_x_hug_00.png"]
[elsif exp="f.lady==8"]
[chara_mod name="tx" time="200" storage="o/sub/aurelia_huge/Aurelia_c_x_hug_00.png"]
[elsif exp="f.lady==12"][chara_mod name="tx" time="200" storage="o/sub/aurelia_huge/Aurelia_xa_hug_00.png"]
[endif]

[wait time="50"][chara_show name="tx" time="0" zindex="7" ][wait time="500"]
[chara_mod name="tear" time="0" storage="o/food/aur_tear_1.png"]
#Aurelia
[aur_sml][aur_sa_1]Mời anh dùng.[p][aur_sl]
[_](Cô ấy mang ra hai tách trà...[p]
[jump target="*aur_tea_next_f"]


*test
[black][stopbgm][bgm_IF]

[eval exp="f.dress=0"]
[random_12][if exp="f.r<=4"]
[call target="*cloth_part"]
[elsif exp="f.r>=5 && f.r<=8"]
[call target="*cloth_part_2"][else]
[call target="*cloth_sexy"][endif]
[eval exp="f.socks=0"]
[random_20]
[if exp="f.dress==5 && f.r>=5 && f.r<=15"][random_Dc_xa][endif]

[random_5]
[if exp="f.r==1 && f.Du_a_on==1"][random_Du_a]
[elsif exp="f.r>=2 && f.r<=4 && f.Du_b_on==1"][random_Du_b]
[elsif exp="f.r==5 && f.Du_c_on==1"][random_Du_c][endif]
[if exp="f.under_p==0"][eval exp="f.under_p=1"][eval exp="f.under_b=1"][endif]
[if exp="f.dress==0 || f.dress==5"][else]
[eval exp="f.under_b=0"][endif]




[hide_message_w][eval exp="f.win_f='c'"][set_win_frame][show_message_w]
[chara_mod name="tear" time="0" storage="o/sub/neph_bath/bath_ef.png" ]
[set_stand]
[bg  time="600"  method="crossfade"  storage="bg/mod/bg_bath_03.jpg" ]
[chara_show name="tear" time="100" left="0" zindex="500" ]
[chara_mod name="sub" time="0" storage="o/sub/nephy/nephy-6b.png"]
[f/cq_nt][call target="*show_stand"]
[chara_show name="sub" time="100" left="0" zindex="1" ]
[anim name="sub" time="400" left="250" ][wait time="10"]

;[jump target="*wekup"]


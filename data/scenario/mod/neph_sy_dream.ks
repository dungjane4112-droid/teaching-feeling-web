[elsif exp="f.r>=2 && f.r<=4 && f.Du_b_on==1"][random_Du_b]
[elsif exp="f.r==5 && f.Du_c_on==1"][random_Du_c][endif]
[if exp="f.under_p==0"][eval exp="f.under_p=1"][eval exp="f.under_b=1"][endif]
[if exp="f.dress==0 || f.dress==5"][else]
[eval exp="f.under_b=0"][endif]
[random_20]
[if exp="f.r>=5 && f.r<=15 && f.Du_b[7]==1"][eval exp="f.under_p=17"][endif]


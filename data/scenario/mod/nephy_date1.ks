*neph_date1_choice
[cm]
[random_6][eval exp="f.ne_love=f.ne_love+3+f.r"]
[eval exp="f.talk=f.talk+f.r"]
[if exp="f.talk>=6"][eval exp="f.talk=0"][timer][endif]
[bg_town][set_weather][if exp="f.act>=5"][free_layermode time="100" wait="false" ][endif]

[if exp="f.act>=6"][jump target="*night"][endif]

[mod_win st="o/win/out_win.png" ]
[set_time]

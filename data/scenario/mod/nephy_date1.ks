-----------------call---------------------------
*set_lady
[random_5]
[if exp="f.r==1"][eval exp="f.lady=6"]
[elsif exp="f.r==2"][eval exp="f.lady=7"]
[elsif exp="f.r==3"][eval exp="f.lady=8"]
[else][eval exp="f.lady=12"][endif][return]

*aur_sx
[if exp="f.lady==6"][chara_mod name="cg6" time="0" storage="o/sub/mod/Aurelia_a_x.png" ]
[elsif exp="f.lady==7"][chara_mod name="cg6" time="0" storage="o/sub/mod/Aurelia_b_x.png" ]
[elsif exp="f.lady==8"][chara_mod name="cg6" time="0" storage="o/sub/mod/Aurelia_c_x.png" ]
[elsif exp="f.lady==12"][chara_mod name="cg6" time="0" storage="o/sub/mod/Aurelia_xa.png" ]
[endif]
[return]


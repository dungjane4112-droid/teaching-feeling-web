;;========script_by_ichibikun============

*neph_date1_wood
[cm]

[stop_bgm][black][bg_outside][set_weather]
[bgm_AT]
[act_win_stand]
[chara_mod name="sub" time="0" storage="o/sub/ne_def/ne_non_a2.png" ]
[chara_show name="sub" time="1" left="0" time="400" wait="true" zindex="20" ]
[anim name="sub" time="250" left="-200" ]
[_](chúng tôi cùng tới khu rừng ven thị trấn.[p]

*neph_date1_choice
[cm]
[random_5][eval exp="f.ne_love=f.ne_love+3+f.r"]
[eval exp="f.talk=f.talk+f.r"]
[if exp="f.talk>=6"][eval exp="f.talk=0"][timer][endif]
[bg_outside][set_weather][if exp="f.act>=5"][free_layermode time="100" wait="false" ][endif]

[if exp="f.act>=6"][jump target="*night"][endif]

[mod_win st="o/win/out_win.png" ]
[set_time]
[button  target="*date1_re"  graphic="s_menu/stay_wood.png"  x="845"  y="160" ]
[button storage="mod/nephy_date1.ks" target="*back_hiroba"  graphic="s_menu/back_hiroba.png"  x="845"  y="240" ]
;[button  storage="mod/market_alone.ks"  target="*market"  graphic="s_menu/market.png"  x="845"  y="320" ]
[button target="*out_date"  graphic="s_menu/finish.png"  x="845"  y="400" ]
[s]


*date1_re_
[cm]
[mod_win st="00.png" ]
[chara_mod name="other" time="10" storage="00.png" ]
[if exp="f.test_ne>=19"][else][eval exp="f.test_ne=19"][endif]
[eval exp="f.test_ne=f.test_ne+1"]
[eval exp="f.r=f.test_ne"][eval exp="f.act=2"]



[if exp="f.r==1"][jump target="*ne_d1_talk1"]

*set_time_scl
[if exp="f.talk==0" ][chara_mod name="other" time="0" storage="o/other/sc0.png" ]
[elsif exp="f.talk==1" ][chara_mod name="other" time="0" storage="o/other/sc1.png" ]
[elsif exp="f.talk==2" ][chara_mod name="other" time="0" storage="o/other/sc2.png" ]
[elsif exp="f.talk==3" ][chara_mod name="other" time="0" storage="o/other/sc3.png" ]
[elsif exp="f.talk>=4 && f.talk<=6" ][chara_mod name="other" time="0" storage="o/other/sc4.png" ]
[elsif exp="f.talk==7" ][chara_mod name="other" time="0" storage="o/other/sc5.png" ]
[elsif exp="f.talk==8" ][chara_mod name="other" time="0" storage="o/other/sc6.png" ]
[endif]
[return]


;;--scrips_by_cihibi

*first_school
[cm]
[syl][f/ss]Vâng! [name], Chúng ta cùng nhau tới trường.[wait time="100"][f/s_nt][sm_05][p_]
[_](...[p]
;[eval exp="f.thoi_tiet=0"]
[bg_town]
(Chúng tôi thong thả bước xuống phố.[lr]
Thời tiết hôm nay thật tuyệt. Sylvie đang rất vui vẻ bước đi...[p]
[bg time="800" method="crossfade" storage="bg/mod/school/04.jpg" ]
[_](Cổng trường Trung học đã xuất hiện phía trước.[lr]
Thông báo một chút với bảo vệ và chúng tôi đã được vào trong.[p]
[bg time="800" method="crossfade" storage="bg/mod/school/05.jpg" ]
[chara_mod name="hat" time="0" storage="00.png" ]
[eval exp="f.syl_talk_1=f.hat"][eval exp="f.hat=0"]
(Theo hướng dẫn, chúng tôi tới làm việc với hiệu trưởng rồi tới lớp 1-2.[p]
[bg time="800" method="crossfade" storage="bg/mod/school/06.jpg" ][l]
[bg time="800" method="crossfade" storage="bg/mod/school/02-2.jpg" ][wait time="800"][bg time="800" method="crossfade" storage="bg/mod/school/02-2.jpg" ]
[syl][f/p]......[p_][f/sp_nt][l][black][chara_00][wait time="800"]
[bg time="500" method="crossfade" storage="bg/mod/school/02.jpg" ]
[_](Sylvie sau khi tự giới thiệu bản thân thì được đưa tới[r] chỗ ngồi của cô ấy trong lớp.[p]
[bg time="800" method="crossfade" storage="bg/mod/school/05.jpg" ]
(Dù vẫn còn hơi lúng túng nhưng chắc cô ấy sẽ sớm hòa nhập với mọi người.[p]
[if exp="f.sch_w=='yet' && f.pyt_st==0"]
[jump target="*pyt_first"]
[else][_](Tôi có thể rời khỏi trường học được rồi.[p]
[jump target="*go_home"]
[endif]

*pyt_first
[cm][eval exp="f.pyt_st=1"]
(Công việc của tôi tại phòng y tế sẽ bắt đầu từ hôm sau.[r]
Tôi sẽ tới đó một chút.[p]
[bg time="800" method="crossfade" storage="bg/mod/school/01.jpg" ][wait time="10"]
[chara_mod name="sub" time="0" storage="o/sub/lily/lily_def.png" ]
[chara_show name="sub" time="500" left="400" time="400" wait="true" zindex="20" ][wait time="500"]
[chara_mod name="sub" time="0" storage="o/sub/lily/lily_sm2.png" ]
#Nữ bác sỹ
[playse loop="false" storage="lily/sa_1.ogg"  clear="true" ]
Chào buổi sáng...[lr]
Tôi có thể giúp gì không?[p]
[chara_mod name="sub" time="0" storage="o/sub/lily/lily_sm1.png" ]
[_](Một nữ bác sỹ với dáng vẻ quen thuộc khiến tôi khá bất ngờ.[lr]
Tôi lúng túng giới thiệu bản thân với khá nhiều nghi vấn về cô ấy.[p]
#Nữ bác sỹ
[chara_mod name="sub" time="0" storage="o/sub/lily/lily_t_r.png" ]
[playse loop="false" storage="lily/ara_2.ogg"  clear="true" ]
Ah! Ra là [name_w]-sensei...Vừa rồi thật xin lỗi.[p]
[chara_mod name="sub" time="0" storage="o/sub/lily/lily_sm2_r.png" ]
Tôi tên là Lilya, là nhân viên y tế của trường.[r]
Rất hân hạnh được cộng tác với anh.[r]
Và cảm ơn anh đã nhận lời tới giúp đỡ.[p]
[chara_mod name="sub" time="0" storage="o/sub/lily/lily_sm1.png" ]
[_](Tôi cùng cô ấy trò chuyện một chút về công việc rồi ra về.[p]
[eval exp="f.lil_love=1"]
[jump target="*go_home"]

*after
[if exp="f.pyt_st>=0"][else][eval exp="f.pyt_st=0"][endif]
[black][chara_00][cm][stopbgm][bgm_DS]
[if exp="f.dress>=71 && f.dress<=74"][call target="*shocks_set"]
[else][call target="*dress_set"][call target="*shocks_set"][endif]

[if exp="f.thoi_tiet==1 || f.thoi_tiet==2 || f.thoi_tiet==3 || f.thoi_tiet==4 || f.thoi_tiet==5"]
[eval exp="f.hair_band=0"][eval exp="f.hair_style=0" ]
[call target="*hat_set"][endif]
[set_stand][bg_door][f/s_nt][show_stand]
[syl][um_10][f/s]Đã đến lúc em phải tới trường rồi.[p_]
[if exp="f.sch>=2"]
[act_win_stand][mod_win st="o/win/out_win.png" ]
[_]
[glink text="Đưa&nbspSylvie&nbsptới&nbsptrường" x=880 y=180 target="*with"]
[glink text="Để&nbspSylvie&nbspđi&nbsptrước" x=880 y=280 target="*alone"]
[s]

[else][eval exp="f.sch=2"]
[jump target="*first_school"][endif]

*alone
[cm]
[eval exp="f.syl_fun=f.syl_fun-10"]
[mod_win st="00.png" ]
[syl][f/s][um_10] Em đi trước nhé! [name].[p_]
[jump storage="mod/home_alone.ks" target="*home"]

*with
[cm][eval exp="f.syl_fun=f.syl_fun+5"]
[mod_win st="00.png" ]
[syl][f/ss]Vâng! [name], Chúng ta cùng nhau tới trường.[wait time="100"][f/s_nt][sm_09][p_]
[_](...[p]
[bg_town]
(Chúng tôi thong thả bước xuống phố.[lr]

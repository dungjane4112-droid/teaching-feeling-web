*go_home_
[cm][jump storage="mod/home_alone.ks" target="*home"]


*hiroba_walk
[_](Tôi sẽ dạo phố một chút.[p]
[black][chara_00][stop_bgm]
[jump storage="mod/hiroba_alone.ks" target="*hiroba"]

[s]





*dress_set
[random_15]
[if exp="f.mua<=2 && f.r<=2"]
[eval exp="f.dress=71"]
[elsif exp="f.mua<=2 && f.r>=3"]
[eval exp="f.dress=72"]
[elsif exp="f.mua>=3 && f.r<=2"]
[eval exp="f.dress=73"]
[elsif exp="f.mua>=3 && f.r>=3"]
[eval exp="f.dress=74"]
[endif][return]

*shocks_set
[if exp="f.dress==71 || f.dress==73"]
[eval exp="f.socks=11"]
[elsif exp="f.dress==72 || f.dress==74"]
[eval exp="f.socks=12"]
[endif][return]


*hat_set
[random_13]
[if exp="f.hat==11"]
[elsif exp="f.hat>=40 && f.hat<=60 && f.thoi_tiet==1"]
[elsif exp="f.hat>=40 && f.hat<=60 && f.thoi_tiet==2"]
[elsif exp="f.hat>=40 && f.hat<=60 && f.thoi_tiet==3"]
[elsif exp="f.hat>=40 && f.hat<=60 && f.thoi_tiet==4"]
[elsif exp="f.hat>=40 && f.hat<=60 && f.thoi_tiet==5"]

[elsif exp="f.r==1][eval exp="f.hat=11"]

[elsif exp="f.r>=6 && f.Dh_e[1]==1 && f.dress==71"][eval exp="f.hat=41"]
[elsif exp="f.r>=6 && f.Dh_e[1]==1 && f.dress==73"][eval exp="f.hat=41"]
[elsif exp="f.r>=6 && f.Dh_e[3]==1 && f.dress==72"][eval exp="f.hat=43"]
[elsif exp="f.r>=6 && f.Dh_e[3]==1 && f.dress==74"][eval exp="f.hat=43"]

[elsif exp="f.r<=6 && f.Dh_f[2]==1 && f.dress==71"][eval exp="f.hat=52"]
[elsif exp="f.r<=6 && f.Dh_f[2]==1 && f.dress==73"][eval exp="f.hat=52"]
[elsif exp="f.r<=6 && f.Dh_f[1]==1 && f.dress==72"][eval exp="f.hat=51"]
[elsif exp="f.r<=6 && f.Dh_f[1]==1 && f.dress==74"][eval exp="f.hat=51"]

[elsif exp="f.r==7 && f.Dh_f[1]==1"][eval exp="f.hat=51"]
[elsif exp="f.r==8 && f.Dh_f[2]==1"][eval exp="f.hat=52"]
[elsif exp="f.r==9 && f.Dh_f[3]==1"][eval exp="f.hat=53"]
[elsif exp="f.r==10 && f.Dh_f[4]==1"][eval exp="f.hat=54"]
[elsif exp="f.r==11 && f.Dh_f[5]==1"][eval exp="f.hat=55"]
[elsif exp="f.r==12 && f.Dh_f[6]==1"][eval exp="f.hat=56"]
[elsif exp="f.r==13 && f.Dh_f[7]==1"][eval exp="f.hat=57"]

[elsif exp="f.r==13 && f.Dh_e[1]==1"][eval exp="f.hat=41"]
[elsif exp="f.r==12 && f.Dh_e[2]==1"][eval exp="f.hat=42"]
[elsif exp="f.r==11 && f.Dh_e[3]==1"][eval exp="f.hat=43"]
[elsif exp="f.r==10 && f.Dh_e[4]==1"][eval exp="f.hat=44"]
[elsif exp="f.r==9 && f.Dh_e[5]==1"][eval exp="f.hat=45"]

[elsif exp="f.r==8 && f.Dh_f[1]==1"][eval exp="f.hat=51"]
[elsif exp="f.r==7 && f.Dh_f[2]==1"][eval exp="f.hat=52"]
[elsif exp="f.r==6 && f.Dh_f[3]==1"][eval exp="f.hat=53"]
[elsif exp="f.r==5 && f.Dh_f[4]==1"][eval exp="f.hat=54"]
[elsif exp="f.r==4 && f.Dh_f[5]==1"][eval exp="f.hat=55"]
[elsif exp="f.r==3 && f.Dh_f[6]==1"][eval exp="f.hat=56"]
[elsif exp="f.r==2 && f.Dh_f[7]==1"][eval exp="f.hat=57"]

[elsif exp="f.r==6 && f.Dh_e[1]==1"][eval exp="f.hat=41"]
[elsif exp="f.r==5 && f.Dh_e[2]==1"][eval exp="f.hat=42"]
[elsif exp="f.r==3 && f.Dh_e[3]==1"][eval exp="f.hat=43"]
[elsif exp="f.r==4 && f.Dh_e[4]==1"][eval exp="f.hat=44"]
[elsif exp="f.r==2 && f.Dh_e[5]==1"][eval exp="f.hat=45"]

[elsif exp="f.r==13 && f.Dh_f[1]==1"][eval exp="f.hat=51"]
[elsif exp="f.r==12 && f.Dh_f[2]==1"][eval exp="f.hat=52"]
[elsif exp="f.r==11 && f.Dh_f[3]==1"][eval exp="f.hat=53"]
[elsif exp="f.r==9 && f.Dh_f[4]==1"][eval exp="f.hat=54"]
[elsif exp="f.r==10 && f.Dh_f[5]==1"][eval exp="f.hat=55"]
[elsif exp="f.r==8 && f.Dh_f[6]==1"][eval exp="f.hat=56"]
[elsif exp="f.r==7 && f.Dh_f[7]==1"][eval exp="f.hat=57"]
[else][eval exp="f.hat=11"]
[endif]
[if exp="f.thoi_tiet==2"][eval exp="f.hat=11"][endif]

[return]
